@page "/messages"
@using AzureSuite.Application.Messages

<PageTitle>Messages</PageTitle>

<h1>PACS.008 Messages</h1>

@if (_sessionExpired)
{
    <p class="text-danger">
        Your session expired and couldn't be refreshed automatically.
        <a href="MicrosoftIdentity/Account/SignIn">Sign in again</a> to continue.
    </p>
}
else if (_errorMessage is not null)
{
    <p class="text-danger">@_errorMessage</p>
}

<h2>Submit a new message</h2>

<EditForm Model="_newMessage" OnValidSubmit="SubmitMessageAsync">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />
    <div class="row g-2">
        <div class="col-md-3">
            <label>Message Id</label>
            <InputText class="form-control" @bind-Value="_newMessage.MessageId" />
        </div>
        <div class="col-md-3">
            <label>End To End Id</label>
            <InputText class="form-control" @bind-Value="_newMessage.EndToEndId" />
        </div>
        <div class="col-md-2">
            <label>Amount</label>
            <InputNumber class="form-control" @bind-Value="_newMessage.Amount" />
        </div>
        <div class="col-md-2">
            <label>Currency</label>
            <InputText class="form-control" @bind-Value="_newMessage.Currency" />
        </div>
        <div class="col-md-3">
            <label>Debtor Name</label>
            <InputText class="form-control" @bind-Value="_newMessage.DebtorName" />
        </div>
        <div class="col-md-3">
            <label>Debtor IBAN</label>
            <InputText class="form-control" @bind-Value="_newMessage.DebtorIban" />
        </div>
        <div class="col-md-2">
            <label>Debtor BIC</label>
            <InputText class="form-control" @bind-Value="_newMessage.DebtorBic" />
        </div>
        <div class="col-md-3">
            <label>Creditor Name</label>
            <InputText class="form-control" @bind-Value="_newMessage.CreditorName" />
        </div>
        <div class="col-md-3">
            <label>Creditor IBAN</label>
            <InputText class="form-control" @bind-Value="_newMessage.CreditorIban" />
        </div>
        <div class="col-md-2">
            <label>Creditor BIC</label>
            <InputText class="form-control" @bind-Value="_newMessage.CreditorBic" />
        </div>
        <div class="col-md-12">
            <label>Remittance Information</label>
            <InputText class="form-control" @bind-Value="_newMessage.RemittanceInformation" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-3" disabled="@_isSubmitting">Submit</button>
</EditForm>

<h2 class="mt-4">Existing messages</h2>

@if (_messages is null)
{
    <p>Loading...</p>
}
else if (_messages.Count == 0)
{
    <p>No messages yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Message Id</th>
                <th>End To End Id</th>
                <th>Amount</th>
                <th>Currency</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var message in _messages)
            {
                <tr>
                    <td>@message.MessageId</td>
                    <td>@message.EndToEndId</td>
                    <td>@message.Amount</td>
                    <td>@message.Currency</td>
                    <td>@message.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
