{
    "version": "2.0.0",
    "tasks": [
        // ---- APIs ----
        {
            "label": "build: Catalog.Api",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/services/Catalog/Catalog.Api/Catalog.Api.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build: Ingestion.Api",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/services/Ingestion/Ingestion.Api/Ingestion.Api.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },

        // ---- Functions ----
        {
            "label": "build: Processing.Functions",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/services/Processing/Processing.Functions/Processing.Functions.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            // Runs the Functions host (Azure Functions Core Tools) against the real Service Bus
            // queue and Cosmos account, using your `az login` identity. Needs Azurite running
            // for the host's own storage (`npx azurite --location .azurite`), since
            // local.settings.json points AzureWebJobsStorage at UseDevelopmentStorage=true.
            // Careful: while this runs it competes with the deployed app for messages.raw.
            "label": "run: Processing.Functions",
            "type": "process",
            "command": "func",
            "args": ["start"],
            "options": { "cwd": "${workspaceFolder}/services/Processing/Processing.Functions" },
            "isBackground": true,
            "problemMatcher": []
        },

        // ---- Websites ----
        {
            "label": "build: Web.Blazor",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/frontends/AzureSuite.Web.Blazor/AzureSuite.Web.Blazor.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },

        // ---- Everything ----
        {
            // The solution build covers every project (tests included) in one MSBuild graph,
            // so shared projects are built once, in the right order. Default for Ctrl+Shift+B.
            "label": "build: everything",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/AzureSuite.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile"
        }
    ]
}
