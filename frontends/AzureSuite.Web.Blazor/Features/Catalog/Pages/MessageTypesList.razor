@page "/"
@using AzureSuite.Catalog.Application.MessageTypes

<PageHeader Title="Registered Message Types" Eyebrow="Catalog">
    <Actions>
        <AppButton Href="/catalog/register" Variant="AppButtonVariant.Primary">Register a new message type</AppButton>
    </Actions>
</PageHeader>

@if (ErrorMessage is not null)
{
    <ErrorState Message="@ErrorMessage" />
}
else if (MessageTypes is null)
{
    <div class="data-table-container">
        <table class="data-table">
            <thead>
                <tr><th>Name</th><th>Version</th><th>Registered</th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < 6; i++)
                {
                    <tr><SkeletonRow ColumnCount="3" /></tr>
                }
            </tbody>
        </table>
    </div>
}
else if (MessageTypes.Count == 0)
{
    <EmptyState Message="No message types registered yet." />
}
else
{
    <DataTable Items="MessageTypes" TItem="MessageTypeDto">
        <HeaderContent>
            <th>Name</th>
            <th>Version</th>
            <th>Registered</th>
        </HeaderContent>
        <RowTemplate Context="messageType">
            <td>@messageType.Name</td>
            <td><AppBadge>@messageType.Version</AppBadge></td>
            <td>@messageType.RegisteredAtUtc</td>
        </RowTemplate>
    </DataTable>
}
