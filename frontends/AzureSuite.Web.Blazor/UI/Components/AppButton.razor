@if (Href is not null)
{
    @* noopener: a page opened in a new tab must not get a handle back to this one. *@
    <a href="@Href" class="app-button @VariantClass" target="@Target" rel="@(Target is null ? null : "noopener noreferrer")">@ChildContent</a>
}
else
{
    <button type="@Type" class="app-button @VariantClass" disabled="@Disabled">@ChildContent</button>
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Href { get; set; }

    /// <summary>Only applies with <see cref="Href"/>, e.g. "_blank" to open in a new tab.</summary>
    [Parameter]
    public string? Target { get; set; }

    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public AppButtonVariant Variant { get; set; } = AppButtonVariant.Primary;

    private string VariantClass => Variant == AppButtonVariant.Primary ? "app-button-primary" : "app-button-secondary";
}
